---
interface Project {
    name: string;
    stack: string;
    description: string;
    link: {
        url?: string;
        target?: string;
        title?: string;
        buttonLabel?: string;
    };
};

const projects: Project[] = [{
    name: 'AI Invoice Management System',
    stack: 'FastAPI · PostgreSQL · Gemini · Mistral · RAG',
    description: 'Led 0→1 development of an AI-native invoice automation tool with a multi-model fallback pipeline (Gemini → Mistral). 95%+ extraction accuracy across varied formats, 500+ invoices processed in week one, and ~70% less manual finance processing time.',
    link: {
        // TODO: add live URL
        buttonLabel: 'View Live'
    }
}, {
    name: 'VeriScript — OCR Intelligence Platform',
    stack: 'Python · FastAPI · vLLM · Docker · RunPod',
    description: 'End-to-end document intelligence pipeline turning scanned, handwritten and unstructured PDFs into validated JSON with Vision LLMs on GPU. Two-phase classify-then-OCR architecture cuts LLM calls and per-document cost; async APIs, batch console with retries, RAG knowledge base and a packaged Windows desktop client.',
    link: {
        // TODO: add repo URL
        buttonLabel: 'View on GitHub'
    }
}, {
    name: 'HEFT India — ERP Interface with AI Layer',
    stack: 'ERPNext · Python · RAG · LLMs · React',
    description: 'LLM-augmented ERP interface for 250+ field workers, replacing manual lookup with RAG-based natural language querying. Auto-fill for approval workflows cut manual effort 60% and drove ERP adoption from 30% → 100% in three months.',
    link: {
        // TODO: add prototype URL
        buttonLabel: 'View Prototype'
    }
}, {
    name: 'Agentic Enterprise RAG Assistant',
    stack: 'FastAPI · LangGraph · GPT-4o · FAISS · BM25 · Tavily',
    description: 'Agentic RAG assistant that autonomously falls back to Tavily web search when internal documents lack the answer. Hybrid retrieval (FAISS dense + BM25 sparse), PDF ingestion with recursive chunking and page-level citations, every response grounded in retrieved context.',
    link: {
        // TODO: add repo URL
        buttonLabel: 'View on GitHub'
    }
}];
---

<div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

        {projects.map(project =>

            <div class="flex flex-col justify-between items-start border border-gray-700 rounded-lg p-4 bg-black">

                <div>

                    <h3 class="text-xl font-semibold text-white mb-1">
                        {project.name}
                    </h3>

                    <p class="text-xs text-primary mb-2">
                        {project.stack}
                    </p>

                    <p class="text-gray-400">
                        {project.description}
                    </p>

                </div>

                {
                    project.link?.url ?
                        <a
                            href={project.link.url}
                            title={project.link.title || project.name}
                            target={project.link.target || '_blank'}
                            class="
                                w-full px-4 py-2.5 mt-4 text-center

                                border border-gray-600 rounded-lg

                                hover:text-primary
                                hover:border-primary
                            ">
                            {project.link.buttonLabel || 'Open Project Website'}
                        </a>
                    : null
                }

            </div>

        )}

    </div>

</div>
